# Singularity/Apptainer definition file for DDCL-MBRL
#
# Mirrors the project Dockerfile exactly so the container can reproduce
# the same runtime environment on any HPC system with Apptainer/Singularity.
#
# BUILD (on a machine with Docker daemon running):
#   docker build -t dcmpc ../
#   apptainer build ddcl_mbrl.sif docker-daemon://dcmpc:latest
#
# BUILD (Singularity-native, no Docker needed, requires internet access):
#   apptainer build ddcl_mbrl.sif ddcl_mbrl.def
#
# QUICK TEST:
#   apptainer exec --nv --bind $PWD:/workspace ddcl_mbrl.sif \
#     bash -lc 'cd /workspace && export MUJOCO_GL=egl PYOPENGL_PLATFORM=egl && \
#               uv run python train.py env=mw-button-press agent=ddcl_cosine seed=0'

Bootstrap: docker
From: python:3.12-slim

%labels
    Author      DDCL-MBRL Project
    Version     1.0
    Description DDCL world model + DC-MPC agent for MBRL research (MuJoCo/Meta-World/DMControl)

%environment
    export DEBIAN_FRONTEND=noninteractive
    export PYTHONDONTWRITEBYTECODE=1
    export PYTHONUNBUFFERED=1
    export PIP_NO_CACHE_DIR=1
    export UV_LINK_MODE=copy
    # Headless MuJoCo rendering via EGL (requires --nv on GPU nodes)
    # Fall back to OSMESA on CPU-only nodes by overriding in the job script.
    export MUJOCO_GL=egl
    export PYOPENGL_PLATFORM=egl
    export MPLBACKEND=Agg
    # Ensure uv is on PATH inside the container
    export PATH=/root/.cargo/bin:/usr/local/bin:$PATH

%post
    set -euo pipefail
    export DEBIAN_FRONTEND=noninteractive

    # ── System libraries ──────────────────────────────────────────────────────
    # Matches the Dockerfile apt-get layer exactly.
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        cmake \
        curl \
        ffmpeg \
        git \
        libavcodec-dev \
        libavformat-dev \
        libegl1 \
        libegl-dev \
        libffi-dev \
        libglew-dev \
        libglfw3 \
        libglfw3-dev \
        libgl1 \
        libgl1-mesa-dev \
        libglib2.0-0 \
        libgomp1 \
        libgles2 \
        libosmesa6 \
        libosmesa6-dev \
        libsm6 \
        libstdc++6 \
        libswscale-dev \
        libx11-6 \
        libxcursor1 \
        libxext6 \
        libxfixes3 \
        libxi6 \
        libxinerama1 \
        libxrandr2 \
        libxrender1 \
        libxxf86vm1 \
        patchelf \
        && rm -rf /var/lib/apt/lists/*

    # ── uv (fast Python package manager) ─────────────────────────────────────
    curl -LsSf https://astral.sh/uv/install.sh | sh
    export PATH=/root/.cargo/bin:/usr/local/bin:$PATH
    # Also copy uv to /usr/local/bin so it is available without .cargo in PATH
    cp /root/.cargo/bin/uv /usr/local/bin/uv
    cp /root/.cargo/bin/uvx /usr/local/bin/uvx

    # ── Python build prerequisite: Cython 0.29 (required by myosuite) ────────
    uv pip install --system "cython==0.29.36"

    # ── Project dependencies ──────────────────────────────────────────────────
    # Copy the pyproject.toml and README.md into /app (project root) and do a
    # dependency-only sync (no source code — code is bind-mounted at runtime).
    mkdir -p /app
    # We cannot COPY during %post, so instead we pre-install via a temporary
    # inline pyproject.toml that lists all production dependencies.
    cat > /tmp/minimal_pyproject.toml << 'EOF'
[project]
name = "dcmpc"
version = "0.1.0"
description = "DDCL-MBRL"
requires-python = ">=3.12"

dependencies = [
    "torch>=2.10.0",
    "torchvision>=0.25.0",
    "torchrl>=0.11.1",
    "tensordict>=0.11.0",
    "numpy>=2.4.0",
    "einops>=0.8.0",
    "jaxtyping>=0.3.0",
    "termcolor>=3.0.0",
    "vector-quantize-pytorch>=1.27.0",
    "wandb>=0.25.0",
    "hydra-core>=1.3.2",
    "hydra-submitit-launcher>=1.2.0",
    "hydra-colorlog>=1.2.0",
    "omegaconf>=2.3.0",
    "dm-control>=1.0.30",
    "gymnasium>=1.2.0",
    "metaworld>=3.0.0",
    "myosuite>=2.11.0",
    "imageio>=2.37.0",
    "imageio-ffmpeg>=0.6.0",
    "moviepy>=2.2.0",
    "av>=16.0.0",
    "seaborn>=0.13.0",
    "matplotlib>=3.10.0",
]

[tool.uv]
override-dependencies = [
    "gymnasium>=1.2.0",
    "mujoco>=3.5.0",
    "dm-control>=1.0.30",
]
EOF
    cp /tmp/minimal_pyproject.toml /app/pyproject.toml
    echo "# placeholder" > /app/README.md
    cd /app && uv sync --no-dev --no-install-project

    # Clean up pip/uv caches to reduce image size
    uv cache clean 2>/dev/null || true
    rm -rf /tmp/minimal_pyproject.toml

%runscript
    # Default run: delegate to whatever command the user provides.
    # Example:
    #   apptainer run --nv --bind $PWD:/workspace ddcl_mbrl.sif \
    #     bash -lc 'cd /workspace && uv run python train.py env=mw-button-press'
    exec "$@"

%test
    # Smoke-test: verify Python and key imports are available.
    python3 -c "import torch; print('torch', torch.__version__)"
    python3 -c "import gymnasium; print('gymnasium', gymnasium.__version__)"
    python3 -c "import metaworld; print('metaworld OK')"
    echo "Container smoke-test passed."
